---
import Container from "@components/Container.astro";

const BRANDS = Array.from({ length: 5 }, (_, i) => ({
    image: `/brands/0${i + 1}.svg`,
}));
---

<Container ClassNameSection="brands" ClassNameMargin="xl:mt-[150px]">
    <div class="flex flex-col xl:flex-row justify-between items-center gap-12">
        {
            BRANDS.map(({ image }) => (
                <img src={image} alt="Brand Logo" class="brands__img" />
            ))
        }
    </div>
</Container>
